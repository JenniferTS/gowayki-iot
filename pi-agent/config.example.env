# Copy to /etc/gowayki/agent.env (install.sh does this).
API_BASE_URL=http://127.0.0.1:8000

# Broker MQTT (TCP 1883)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=gowayki

# Optional: open Chromium kiosk after pairing
ENABLE_KIOSK_DISPLAY=1

# Optional one-shot pair (preferred: /etc/gowayki/pair.code)
# PAIR_CODE=
