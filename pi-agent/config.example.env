# Copy to /etc/gowayki/agent.env (install.sh does this).
API_BASE_URL=https://paradero.172-214-154-175.sslip.io

# Mosquitto de la VM — usar MQTTS (8883). El 1883 suele estar bloqueado desde fuera.
MQTT_HOST=172-214-154-175.sslip.io
MQTT_PORT=8883
MQTT_TLS=1
MQTT_USER=gowayki-pi
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=gowayki

# Optional: open Chromium kiosk after pairing
ENABLE_KIOSK_DISPLAY=1

# Optional one-shot pair (preferred: /etc/gowayki/pair.code)
# PAIR_CODE=
