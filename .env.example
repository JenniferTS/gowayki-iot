# Base pública del panel (sin slash final)
BASE_URL=http://127.0.0.1:8000

# Postgres GTFS (solo lectura). Vacío = panel sin datos de rutas (o usa GTFS_LOCAL_DIR).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/gtfs

# SQLite del panel (kioscos, códigos, heartbeat). En Docker montar /data.
APP_DB_PATH=./data/iot.db

# Token del panel admin (header X-Admin-Token o cookie)
ADMIN_TOKEN=change-me-long-random

# Firma de cookies/sesiones
SECRET_KEY=change-me-another-long-random

# Puerto interno
PORT=8000

# Playlist demo (URLs separadas por coma; vacío = placeholders locales)
AD_PLAYLIST_URLS=

# MQTT (bridge del panel). Vacío MQTT_HOST = bridge desactivado.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=gowayki
MQTT_GPIO_PREFIX=paradero

# Usuarios MQTT del panel: directorio compartido con Mosquitto (passwd/acl dinámicos)
MQTT_AUTH_DIR=
# Host/puerto que se muestran a los usuarios del equipo
MQTT_PUBLIC_HOST=localhost
MQTT_PUBLIC_PORT=1883

# Opcional: carpeta GTFS local (CSV) para pruebas sin Postgres
# GTFS_LOCAL_DIR=
