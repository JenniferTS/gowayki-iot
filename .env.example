# Base pública del panel (sin slash final). En el paradero principal: .../iot
BASE_URL=https://paradero.172-214-154-175.sslip.io/iot

# Prefijo público detrás de nginx (strip). Vacío en local; en VM del grupo: /iot
ROOT_PATH=/iot

# Postgres GTFS (solo lectura). Usar BD gtfs-arequipa, NO postgres/OpenProject.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/gtfs-arequipa

# SQLite del panel (kioscos, códigos, heartbeat). En VM montar /data.
APP_DB_PATH=/data/iot.db

# Token del panel admin (header X-Admin-Token o query ?token=)
ADMIN_TOKEN=change-me-long-random

# Firma de cookies/sesiones
SECRET_KEY=change-me-another-long-random

# Puerto interno (en la VM del paradero: 8002; Django usa 8000)
PORT=8002

# Playlist demo (URLs separadas por coma; vacío = placeholders locales)
AD_PLAYLIST_URLS=

# MQTT de la VM (bridge del panel). Vacío = bridge desactivado.
MQTT_HOST=172-214-154-175.sslip.io
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=gowayki
MQTT_GPIO_PREFIX=paradero

# Usuarios MQTT del panel: directorio compartido con Mosquitto (passwd/acl dinámicos)
MQTT_AUTH_DIR=
# Host/puerto que se muestran a los usuarios del equipo
MQTT_PUBLIC_HOST=172-214-154-175.sslip.io
MQTT_PUBLIC_PORT=1883

# Feed GTFS local (CSV). Alternativa a DATABASE_URL.
# Descargar: https://github.com/trufi-association/trufi-arequipa (out/city.gtfs.zip)
GTFS_LOCAL_DIR=./data/gtfs

# Playlist de anuncios del Paradero Digital (Django). Mismo PANEL_IOT_TOKEN que Django.
# Vacío = solo anuncios locales del admin /iot.
DJANGO_URL=http://127.0.0.1:8000
DJANGO_PANEL_TOKEN=
DJANGO_TIMEOUT_SEC=4
